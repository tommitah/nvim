(when _G.vim.g.neovide
  (set _G.vim.o.guifont "ZedMono Nerd Font Mono:h28")
  (set _G.vim.g.neovide_window_blurred true)
  (set _G.vim.g.neovide_opacity 0.7)
  (set _G.vim.g.neovide_normal_opacity 0.7)
  (set _G.vim.g.neovide_hide_mouse_when_typing true)
  (set _G.vim.g.experimental_layer_grouping true))
